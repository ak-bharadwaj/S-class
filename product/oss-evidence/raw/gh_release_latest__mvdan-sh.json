 -ldflags=\"-w -s\"","reactions":{"url":"https://api.github.com/repos/mvdan/sh/releases/383624083/reactions","total_count":8,"+1":6,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":2,"eyes":0}}