"patched_versions":"3.26.7","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[],"cwe_ids":[],"credits":[{"login":"MaccariTA","type":"reporter"}],"credits_detailed":[{"user":{"login":"MaccariTA","id":20310946,"node_id":"MDQ6VXNlcjIwMzEwOTQ2","avatar_url":"https://avatars.githubusercontent.com/u/20310946?v=4","gravatar_id":"","url":"https://api.github.com/users/MaccariTA","html_url":"https://github.com/MaccariTA","followers_url":"https://api.github.com/users/MaccariTA/followers","following_url":"https://api.github.com/users/MaccariTA/following{/other_user}","gists_url":"https://api.github.com/users/MaccariTA/gists{/gist_id}","starred_url":"https://api.github.com/users/MaccariTA/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MaccariTA/subscriptions","organizations_url":"https://api.github.com/users/MaccariTA/orgs","repos_url":"https://api.github.com/users/MaccariTA/repos","events_url":"https://api.github.com/users/MaccariTA/events{/privacy}","received_events_url":"https://api.github.com/users/MaccariTA/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter","state":"accepted"}],"collaborating_users":null,"collaborating_teams":null,"private_fork":null,"comments":1,"cvss":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1}},{"ghsa_id":"GHSA-c292-qxq4-4p2v","cve_id":"CVE-2025-58374","url":"https://api.github.com/repos/RooCodeInc/Roo-Code/security-advisories/GHSA-c292-qxq4-4p2v","html_url":"https://github.com/RooCodeInc/Roo-Code/security/advisories/GHSA-c292-qxq4-4p2v","summary":"Auto-approve allows npm install execution of malicious postinstall acripts","description":"### Summary\r\n\r\nThe extension contains a default list of allowed commands that do not need manual approval if auto-approve is enabled, and npm install was included in that list. Because npm install executes lifecycle scripts, if a repository’s package.json file contains a malicious postinstall script, it would be executed automatically without user approval. This means that enabling auto-approved commands and opening a malicious repo could result in arbitrary code execution.\r\n\r\n### Impact\r\n\r\nThis vulnerability allows an attacker to achieve arbitrary code execution on the developer’s system by placing a malicious postinstall (or similar lifecycle script) in package.json.\r\n\r\n### Remediation\r\n\r\nThe issue was fixed by removing dangerous commands from the default auto-approve allowlist as well as removing these previously default commands from the allowlist when the extension is updated.","severity":"high","author":null,"publisher":{"login":"mrubens","id":2600,"node_id":"MDQ6VXNlcjI2MDA=","avatar_url":"https://avatars.githubusercontent.com/u/2600?v=4","gravatar_id":"","url":"https://api.github.com/users/mrubens","html_url":"https://github.com/mrubens","followers_url":"https://api.github.com/users/mrubens/followers","following_url":"https://api.github.com/users/mrubens/following{/other_user}","gists_url":"https://api.github.com/users/mrubens/gists{/gist_id}","starred_url":"https://api.github.com/users/mrubens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrubens/subscriptions","organizations_url":"https://api.github.com/users/mrubens/orgs","repos_url":"https://api.github.com/users/mrubens/repos","events_url":"https://api.github.com/users/mrubens/events{/privacy}","received_events_url":"https://api.github.com/users/mrubens/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-c292-qxq4-4p2v","type":"GHSA"},{"value":"CVE-2025-58374","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2025-09-04T19:11:18Z","published_at":"2025-09-04T05:46:28Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"","name":""},"vulnerable_version_range":"< 3.26.0","patched_versions":"3.26.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","score":7.8},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[],"cwe_ids":[],"credits":[{"login":"thelicato","type":"reporter"}],"credits_detailed":[{"user":{"login":"thelicato","id":20096272,"node_id":"MDQ6VXNlcjIwMDk2Mjcy","avatar_url":"https://avatars.githubusercontent.com/u/20096272?v=4","gravatar_id":"","url":"https://api.github.com/users/thelicato","html_url":"https://github.com/thelicato","followers_url":"https://api.github.com/users/thelicato/followers","following_url":"https://api.github.com/users/thelicato/following{/other_user}","gists_url":"https://api.github.com/users/thelicato/gists{/gist_id}","starred_url":"https://api.github.com/users/thelicato/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thelicato/subscriptions","organizations_url":"https://api.github.com/users/thelicato/orgs","repos_url":"https://api.github.com/users/thelicato/repos","events_url":"https://api.github.com/users/thelicato/events{/privacy}","received_events_url":"https://api.github.com/users/thelicato/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter","state":"accepted"}],"collaborating_users":null,"collaborating_teams":null,"private_fork":null,"comments":1,"cvss":{"vector_string":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","score":7.8}},{"ghsa_id":"GHSA-p76r-7mc3-qh7c","cve_id":"CVE-2025-58373","url":"https://api.github.com/repos/RooCodeInc/Roo-Code/security-advisories/GHSA-p76r-7mc3-qh7c","html_url":"https://github.com/RooCodeInc/Roo-Code/security/advisories/GHSA-p76r-7mc3-qh7c","summary":"Symlink-bypass of .rooignore leading to unintended file disclosure","description":"## Summary\r\n\r\nA vulnerability was identified where .rooignore protections could be bypassed using symlinks. This allowed an attacker with write access to the workspace to trick the extension into reading files that were intended to be excluded. As a result, sensitive files such as .env or configuration files could be exposed.\r\n\r\n### Impact\r\n\r\nAn attacker able to modify files within the workspace could gain unauthorized access to sensitive information by bypassing .rooignore rules. This could include secrets, configuration details, or other excluded project data.\r\n\r\n### Remediation\r\n\r\nWe now validate .rooignore rules both before and after following symlinks, preventing this type of bypass.\r\n","severity":"medium","author":null,"publisher":{"login":"mrubens","id":2600,"node_id":"MDQ6VXNlcjI2MDA=","avatar_url":"https://avatars.githubusercontent.com/u/2600?v=4","gravatar_id":"","url":"https://api.github.com/users/mrubens","html_url":"https://github.com/mrubens","followers_url":"https://api.github.com/users/mrubens/followers","following_url":"https://api.github.com/users/mrubens/following{/other_user}","gists_url":"https://api.github.com/users/mrubens/gists{/gist_id}","starred_url":"https://api.github.com/users/mrubens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrubens/subscriptions","organizations_url":"https://api.github.com/users/mrubens/orgs","repos_url":"https://api.github.com/users/mrubens/repos","events_url":"https://api.github.com/users/mrubens/events{/privacy}","received_events_url":"https://api.github.com/users/mrubens/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-p76r-7mc3-qh7c","type":"GHSA"},{"value":"CVE-2025-58373","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2025-09-04T19:10:59Z","published_at":"2025-09-04T05:46:24Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"","name":""},"vulnerable_version_range":"< 3.26.0","patched_versions":"3.26.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:N/A:N","score":5.5},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[],"cwe_ids":[],"credits":[{"login":"thelicato","type":"reporter"}],"credits_detailed":[{"user":{"login":"thelicato","id":20096272,"node_id":"MDQ6VXNlcjIwMDk2Mjcy","avatar_url":"https://avatars.githubusercontent.com/u/20096272?v=4","gravatar_id":"","url":"https://api.github.com/users/thelicato","html_url":"https://github.com/thelicato","followers_url":"https://api.github.com/users/thelicato/followers","following_url":"https://api.github.com/users/thelicato/following{/other_user}","gists_url":"https://api.github.com/users/thelicato/gists{/gist_id}","starred_url":"https://api.github.com/users/thelicato/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thelicato/subscriptions","organizations_url":"https://api.github.com/users/thelicato/orgs","repos_url":"https://api.github.com/users/thelicato/repos","events_url":"https://api.github.com/users/thelicato/events{/privacy}","received_events_url":"https://api.github.com/users/thelicato/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter","state":"accepted"}],"collaborating_users":null,"collaborating_teams":null,"private_fork":null,"comments":1,"cvss":{"vector_string":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:N/A:N","score":5.5}},{"ghsa_id":"GHSA-4pqh-4ggm-jfmm","cve_id":"CVE-2025-58372","url":"https://api.github.com/repos/RooCodeInc/Roo-Code/security-advisories/GHSA-4pqh-4ggm-jfmm","html_url":"https://github.com/RooCodeInc/Roo-Code/security/advisories/GHSA-4pqh-4ggm-jfmm","summary":"Potential Remote Code Execution via .code-workspace","description":"### Summary\r\n\r\nA vulnerability was identified where certain VS Code workspace configuration files (.code-workspace) were not protected in the same way as the .vscode folder. If the agent was configured to auto-approve file writes, an attacker able to influence prompts (for example via prompt injection) could cause malicious workspace settings or tasks to be written. These tasks could then be executed automatically when the workspace is reopened, resulting in arbitrary code execution.\r\n\r\n### Impact\r\n\r\nThis issue is of high complexity because it requires both the ability to submit prompts and the user having auto-approve for file writes enabled (which is off by default). However, the severity is high, since successful exploitation allows arbitrary code execution in the victim’s environment.\r\n\r\n### Remediation\r\n\r\nWe mitigated the issue by adding *.code-workspace to the list of protected files. Any write attempts to these files now require explicit opt-in approval rather than being auto-approved.","severity":"high","author":null,"publisher":{"login":"mrubens","id":2600,"node_id":"MDQ6VXNlcjI2MDA=","avatar_url":"https://avatars.githubusercontent.com/u/2600?v=4","gravatar_id":"","url":"https://api.github.com/users/mrubens","html_url":"https://github.com/mrubens","followers_url":"https://api.github.com/users/mrubens/followers","following_url":"https://api.github.com/users/mrubens/following{/other_user}","gists_url":"https://api.github.com/users/mrubens/gists{/gist_id}","starred_url":"https://api.github.com/users/mrubens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrubens/subscriptions","organizations_url":"https://api.github.com/users/mrubens/orgs","repos_url":"https://api.github.com/users/mrubens/repos","events_url":"https://api.github.com/users/mrubens/events{/privacy}","received_events_url":"https://api.github.com/users/mrubens/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-4pqh-4ggm-jfmm","type":"GHSA"},{"value":"CVE-2025-58372","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2025-09-04T19:09:57Z","published_at":"2025-09-04T05:46:21Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"","name":""},"vulnerable_version_range":"< 3.26.0","patched_versions":"3.26.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[],"cwe_ids":[],"credits":[{"login":"thelicato","type":"reporter"}],"credits_detailed":[{"user":{"login":"thelicato","id":20096272,"node_id":"MDQ6VXNlcjIwMDk2Mjcy","avatar_url":"https://avatars.githubusercontent.com/u/20096272?v=4","gravatar_id":"","url":"https://api.github.com/users/thelicato","html_url":"https://github.com/thelicato","followers_url":"https://api.github.com/users/thelicato/followers","following_url":"https://api.github.com/users/thelicato/following{/other_user}","gists_url":"https://api.github.com/users/thelicato/gists{/gist_id}","starred_url":"https://api.github.com/users/thelicato/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thelicato/subscriptions","organizations_url":"https://api.github.com/users/thelicato/orgs","repos_url":"https://api.github.com/users/thelicato/repos","events_url":"https://api.github.com/users/thelicato/events{/privacy}","received_events_url":"https://api.github.com/users/thelicato/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter","state":"accepted"}],"collaborating_users":null,"collaborating_teams":null,"private_fork":null,"comments":1,"cvss":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1}},{"ghsa_id":"GHSA-2rm5-cvcm-7592","cve_id":"CVE-2025-58370","url":"https://api.github.com/repos/RooCodeInc/Roo-Code/security-advisories/GHSA-2rm5-cvcm-7592","html_url":"https://github.com/RooCodeInc/Roo-Code/security/advisories/GHSA-2rm5-cvcm-7592","summary":"Potential Remote Code Execution via Bash Parameter Expansion and Indirect Reference","description":"### Summary\r\n\r\nA vulnerability was identified in the command parsing logic where Bash parameter expansion and indirect reference were not handled correctly. If the agent was configured to auto-approve execution of certain commands, an attacker able to influence prompts could abuse this weakness to execute additional arbitrary commands alongside the intended one.\r\n\r\n### Impact\r\n\r\nThis issue is of high complexity since it requires prompt injection capabilities and auto-approved command execution (off by default). However, the severity is high because successful exploitation results in arbitrary code execution.\r\n\r\n### Remediation\r\n\r\nWe updated the command parsing logic to correctly detect and block dangerous substitution patterns, requiring explicit approval before execution.","severity":"high","author":null,"publisher":{"login":"mrubens","id":2600,"node_id":"MDQ6VXNlcjI2MDA=","avatar_url":"https://avatars.githubusercontent.com/u/2600?v=4","gravatar_id":"","url":"https://api.github.com/users/mrubens","html_url":"https://github.com/mrubens","followers_url":"https://api.github.com/users/mrubens/followers","following_url":"https://api.github.com/users/mrubens/following{/other_user}","gists_url":"https://api.github.com/users/mrubens/gists{/gist_id}","starred_url":"https://api.github.com/users/mrubens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrubens/subscriptions","organizations_url":"https://api.github.com/users/mrubens/orgs","repos_url":"https://api.github.com/users/mrubens/repos","events_url":"https://api.github.com/users/mrubens/events{/privacy}","received_events_url":"https://api.github.com/users/mrubens/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-2rm5-cvcm-7592","type":"GHSA"},{"value":"CVE-2025-58370","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2025-09-04T17:38:11Z","published_at":"2025-09-04T05:46:49Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"","name":""},"vulnerable_version_range":"< 3.26.0","patched_versions":"3.26.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[],"cwe_ids":[],"credits":[{"login":"febou92","type":"reporter"}],"credits_detailed":[{"user":{"login":"febou92","id":49501801,"node_id":"MDQ6VXNlcjQ5NTAxODAx","avatar_url":"https://avatars.githubusercontent.com/u/49501801?v=4","gravatar_id":"","url":"https://api.github.com/users/febou92","html_url":"https://github.com/febou92","followers_url":"https://api.github.com/users/febou92/followers","following_url":"https://api.github.com/users/febou92/following{/other_user}","gists_url":"https://api.github.com/users/febou92/gists{/gist_id}","starred_url":"https://api.github.com/users/febou92/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/febou92/subscriptions","organizations_url":"https://api.github.com/users/febou92/orgs","repos_url":"https://api.github.com/users/febou92/repos","events_url":"https://api.github.com/users/febou92/events{/privacy}","received_events_url":"https://api.github.com/users/febou92/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter","state":"accepted"}],"collaborating_users":null,"collaborating_teams":null,"private_fork":null,"comments":1,"cvss":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1}},{"ghsa_id":"GHSA-xr6r-vj48-29f6","cve_id":"CVE-2025-58371","url":"https://api.github.com/repos/RooCodeInc/Roo-Code/security-advisories/GHSA-xr6r-vj48-29f6","html_url":"https://github.com/RooCodeInc/Roo-Code/security/advisories/GHSA-xr6r-vj48-29f6","summary":"Critical command injection vulnerability in GitHub actions workflow ","description":"### Summary\r\n\r\nA critical command injection vulnerability was discovered in the discord-pr-notify.yml GitHub Actions workflow of the RooCodeInc/Roo-Code repository. The workflow used unsanitized pull request metadata in a privileged context, allowing an attacker to craft malicious input and achieve Remote Code Execution (RCE) on the Actions runner.\r\n\r\n### Impact\r\n\r\nThe vulnerability’s impact is severe due to the workflow running with broad permissions and access to repository secrets. An attacker could:\r\n- Execute arbitrary commands on the runner.\r\n- Push or modify code in the repository.\r\n- Access sensitive secrets, such as webhook credentials.\r\n- Create malicious releases or packages.\r\n\r\nThis could result in a complete compromise of the repository and its associated services.\r\n\r\n### Resolution\r\n\r\nThe vulnerable workflow has been removed, and all affected secrets have been rotated.","severity":"critical","author":null,"publisher":{"login":"mrubens","id":2600,"node_id":"MDQ6VXNlcjI2MDA=","avatar_url":"https://avatars.githubusercontent.com/u/2600?v=4","gravatar_id":"","url":"https://api.github.com/users/mrubens","html_url":"https://github.com/mrubens","followers_url":"https://api.github.com/users/mrubens/followers","following_url":"https://api.github.com/users/mrubens/following{/other_user}","gists_url":"https://api.github.com/users/mrubens/gists{/gist_id}","starred_url":"https://api.github.com/users/mrubens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrubens/subscriptions","organizations_url":"https://api.github.com/users/mrubens/orgs","repos_url":"https://api.github.com/users/mrubens/repos","events_url":"https://api.github.com/users/mrubens/events{/privacy}","received_events_url":"https://api.github.com/users/mrubens/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-xr6r-vj48-29f6","type":"GHSA"},{"value":"CVE-2025-58371","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2025-09-04T17:39:06Z","published_at":"2025-09-04T05:47:16Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"actions","name":""},"vulnerable_version_range":"Commits prior to a0384f3","patched_versions":"Commit a0384f3","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":null},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[],"cwe_ids":[],"credits":[{"login":"yaronav","type":"reporter"}],"credits_detailed":[{"user":{"login":"yaronav","id":39116794,"node_id":"MDQ6VXNlcjM5MTE2Nzk0","avatar_url":"https://avatars.githubusercontent.com/u/39116794?v=4","gravatar_id":"","url":"https://api.github.com/users/yaronav","html_url":"https://github.com/yaronav","followers_url":"https://api.github.com/users/yaronav/followers","following_url":"https://api.github.com/users/yaronav/following{/other_user}","gists_url":"https://api.github.com/users/yaronav/gists{/gist_id}","starred_url":"https://api.github.com/users/yaronav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yaronav/subscriptions","organizations_url":"https://api.github.com/users/yaronav/orgs","repos_url":"https://api.github.com/users/yaronav/repos","events_url":"https://api.github.com/users/yaronav/events{/privacy}","received_events_url":"https://api.github.com/users/yaronav/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter","state":"accepted"}],"collaborating_users":null,"collaborating_teams":null,"private_fork":null,"comments":2,"cvss":{"vector_string":null,"score":null}},{"ghsa_id":"GHSA-wrh9-463x-7wvv","cve_id":"CVE-2025-57771","url":"https://api.github.com/repos/RooCodeInc/Roo-Code/security-advisories/GHSA-wrh9-463x-7wvv","html_url":"https://github.com/RooCodeInc/Roo-Code/security/advisories/GHSA-wrh9-463x-7wvv","summary":"Potential Remote Code Execution via Auto-Execute Commands","description":"### Summary\r\n\r\nIf the victim has \"Execute\" auto-approved for a specific command like `ls`, an attacker with access to craft a prompt could inject arbitrary commands to be sent alongside the original auto-executed command because process substitution and the single ampersand were not handled correctly in the command parsing logic.\r\n\r\n### Impact\r\n\r\nThis vulnerability is high complexity since it requires the attacker to already be able to submit prompts to the agent (for instance through a prompt injection attack) and for the user to have enabled auto-approved command execution (off by default), but also of high severity since it would give the attacker the ability to execute arbitrary code.\r\n\r\n### Remediation\r\n\r\nWe fixed the command parsing to correctly handle process substitution.","severity":"high","author":null,"publisher":{"login":"mrubens","id":2600,"node_id":"MDQ6VXNlcjI2MDA=","avatar_url":"https://avatars.githubusercontent.com/u/2600?v=4","gravatar_id":"","url":"https://api.github.com/users/mrubens","html_url":"https://github.com/mrubens","followers_url":"https://api.github.com/users/mrubens/followers","following_url":"https://api.github.com/users/mrubens/following{/other_user}","gists_url":"https://api.github.com/users/mrubens/gists{/gist_id}","starred_url":"https://api.github.com/users/mrubens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrubens/subscriptions","organizations_url":"https://api.github.com/users/mrubens/orgs","repos_url":"https://api.github.com/users/mrubens/repos","events_url":"https://api.github.com/users/mrubens/events{/privacy}","received_events_url":"https://api.github.com/users/mrubens/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-wrh9-463x-7wvv","type":"GHSA"},{"value":"CVE-2025-57771","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2025-09-04T15:51:12Z","published_at":"2025-08-22T06:42:29Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"","name":""},"vulnerable_version_range":"< 3.25.5","patched_versions":"3.25.5","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[],"cwe_ids":[],"credits":[{"login":"MaccariTA","type":"reporter"}],"credits_detailed":[{"user":{"login":"MaccariTA","id":20310946,"node_id":"MDQ6VXNlcjIwMzEwOTQ2","avatar_url":"https://avatars.githubusercontent.com/u/20310946?v=4","gravatar_id":"","url":"https://api.github.com/users/MaccariTA","html_url":"https://github.com/MaccariTA","followers_url":"https://api.github.com/users/MaccariTA/followers","following_url":"https://api.github.com/users/MaccariTA/following{/other_user}","gists_url":"https://api.github.com/users/MaccariTA/gists{/gist_id}","starred_url":"https://api.github.com/users/MaccariTA/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MaccariTA/subscriptions","organizations_url":"https://api.github.com/users/MaccariTA/orgs","repos_url":"https://api.github.com/users/MaccariTA/repos","events_url":"https://api.github.com/users/MaccariTA/events{/privacy}","received_events_url":"https://api.github.com/users/MaccariTA/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter","state":"accepted"}],"collaborating_users":null,"collaborating_teams":null,"private_fork":null,"comments":1,"cvss":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1}},{"ghsa_id":"GHSA-p278-52x9-cffx","cve_id":"CVE-2025-54377","url":"https://api.github.com/repos/RooCodeInc/Roo-Code/security-advisories/GHSA-p278-52x9-cffx","html_url":"https://github.com/RooCodeInc/Roo-Code/security/advisories/GHSA-p278-52x9-cffx","summary":"Missing Line Break Validation in Command Execution Tool","description":"**Summary**  \r\nRooCode does not validate line breaks (`\\n`) in command input, allowing potential bypass of the allow-list mechanism.\r\n\r\n**Details**  \r\nRooCode appears to lack parsing or validation logic to prevent multi-line command injection. When commands are evaluated for execution, only the first line or token may be considered, enabling attackers to smuggle additional commands in subsequent lines.\r\n\r\nFor example, if only `tsc` is allow-listed, the following command:\r\n\r\n```\r\ntsc\r\npython3 ./ex.py\r\n```\r\n\r\nwould still result in the execution of `python3`, even though it is not on the allow list. This bypass undermines the integrity of the allow-list policy and allows unintended command execution.\r\n\r\n**PoC**\r\n```bash\r\ntsc\r\npython3 ./ex.py\r\n```\r\n\r\n**Impact**  \r\nThis vulnerability allows a user to execute disallowed commands by inserting them after a line break in a multi-line input, effectively bypassing command restrictions.","severity":"high","author":null,"publisher":{"login":"mrubens","id":2600,"node_id":"MDQ6VXNlcjI2MDA=","avatar_url":"https://avatars.githubusercontent.com/u/2600?v=4","gravatar_id":"","url":"https://api.github.com/users/mrubens","html_url":"https://github.com/mrubens","followers_url":"https://api.github.com/users/mrubens/followers","following_url":"https://api.github.com/users/mrubens/following{/other_user}","gists_url":"https://api.github.com/users/mrubens/gists{/gist_id}","starred_url":"https://api.github.com/users/mrubens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrubens/subscriptions","organizations_url":"https://api.github.com/users/mrubens/orgs","repos_url":"https://api.github.com/users/mrubens/repos","events_url":"https://api.github.com/users/mrubens/events{/privacy}","received_events_url":"https://api.github.com/users/mrubens/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-p278-52x9-cffx","type":"GHSA"},{"value":"CVE-2025-54377","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2025-07-23T19:28:58Z","published_at":"2025-07-23T18:01:53Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"","name":"Roo Code"},"vulnerable_version_range":"<3.23.19","patched_versions":"3.23.19","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","score":7.8},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[{"cwe_id":"CWE-77","name":"Improper Neutralization of Special Elements used in a Command"}],"cwe_ids":["CWE-77"],"credits":[{"login":"yellowday60-git","type":"reporter"},{"login":"MaccariTA","type":"reporter"}],"credits_detailed":[{"user":{"login":"yellowday60-git","id":45089989,"node_id":"MDQ6VXNlcjQ1MDg5OTg5","avatar_url":"https://avatars.githubusercontent.com/u/45089989?v=4","gravatar_id":"","url":"https://api.github.com/users/yellowday60-git","html_url":"https://github.com/yellowday60-git","followers_url":"https://api.github.com/users/yellowday60-git/followers","following_url":"https://api.github.com/users/yellowday60-git/following{/other_user}","gists_url":"https://api.github.com/users/yellowday60-git/gists{/gist_id}","starred_url":"https://api.github.com/users/yellowday60-git/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yellowday60-git/subscriptions","organizations_url":"https://api.github.com/users/yellowday60-git/orgs","repos_url":"https://api.github.com/users/yellowday60-git/repos","events_url":"https://api.github.com/users/yellowday60-git/events{/privacy}","received_events_url":"https://api.github.com/users/yellowday60-git/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter","state":"accepted"},{"user":{"login":"MaccariTA","id":20310946,"node_id":"MDQ6VXNlcjIwMzEwOTQ2","avatar_url":"https://avatars.githubusercontent.com/u/20310946?v=4","gravatar_id":"","url":"https://api.github.com/users/MaccariTA","html_url":"https://github.com/MaccariTA","followers_url":"https://api.github.com/users/MaccariTA/followers","following_url":"https://api.github.com/users/MaccariTA/following{/other_user}","gists_url":"https://api.github.com/users/MaccariTA/gists{/gist_id}","starred_url":"https://api.github.com/users/MaccariTA/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MaccariTA/subscriptions","organizations_url":"https://api.github.com/users/MaccariTA/orgs","repos_url":"https://api.github.com/users/MaccariTA/repos","events_url":"https://api.github.com/users/MaccariTA/events{/privacy}","received_events_url":"https://api.github.com/users/MaccariTA/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter","state":"accepted"}],"collaborating_users":null,"collaborating_teams":null,"private_fork":null,"comments":2,"cvss":{"vector_string":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","score":7.8}},{"ghsa_id":"GHSA-3765-5vjr-qjgm","cve_id":"CVE-2025-53536","url":"https://api.github.com/repos/RooCodeInc/Roo-Code/security-advisories/GHSA-3765-5vjr-qjgm","html_url":"https://github.com/RooCodeInc/Roo-Code/security/advisories/GHSA-3765-5vjr-qjgm","summary":"Potential Remote Code Execution via .vscode/settings.json in the Roo Code extension","description":"### Summary\r\n\r\nIf the victim had \"Write\" auto-approved an attacker with the ability to submit prompts to the agent could write to VS Code settings files and trigger code execution. There were multiple ways to achieve that. One example is with the `php.validate.executablePath` setting which lets you set the path for the php executable for syntax validation. The attacker could have written the path to an arbitrary command there and then created a php file to trigger it.\r\n\r\n### Impact\r\n\r\nThis vulnerability is high complexity since it requires the attacker to already be able to submit prompts to the agent (for instance through a prompt injection attack) and for the user to have enabled auto-approved file writes (off by default), but also of high severity since it would give the attacker the ability to execute arbitrary code.\r\n\r\n### Remediation\r\n\r\nWe added the `.vscode/` folder to the list of protected files that require an additional layer of opt-in configuration for auto-approving writes.","severity":"high","author":null,"publisher":{"login":"mrubens","id":2600,"node_id":"MDQ6VXNlcjI2MDA=","avatar_url":"https://avatars.githubusercontent.com/u/2600?v=4","gravatar_id":"","url":"https://api.github.com/users/mrubens","html_url":"https://github.com/mrubens","followers_url":"https://api.github.com/users/mrubens/followers","following_url":"https://api.github.com/users/mrubens/following{/other_user}","gists_url":"https://api.github.com/users/mrubens/gists{/gist_id}","starred_url":"https://api.github.com/users/mrubens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrubens/subscriptions","organizations_url":"https://api.github.com/users/mrubens/orgs","repos_url":"https://api.github.com/users/mrubens/repos","events_url":"https://api.github.com/users/mrubens/events{/privacy}","received_events_url":"https://api.github.com/users/mrubens/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-3765-5vjr-qjgm","type":"GHSA"},{"value":"CVE-2025-53536","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2025-07-07T14:40:42Z","published_at":"2025-07-07T02:46:03Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"","name":""},"vulnerable_version_range":"< 3.22.6","patched_versions":"3.22.6","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[],"cwe_ids":[],"credits":[{"login":"MaccariTA","type":"reporter"}],"credits_detailed":[{"user":{"login":"MaccariTA","id":20310946,"node_id":"MDQ6VXNlcjIwMzEwOTQ2","avatar_url":"https://avatars.githubusercontent.com/u/20310946?v=4","gravatar_id":"","url":"https://api.github.com/users/MaccariTA","html_url":"https://github.com/MaccariTA","followers_url":"https://api.github.com/users/MaccariTA/followers","following_url":"https://api.github.com/users/MaccariTA/following{/other_user}","gists_url":"https://api.github.com/users/MaccariTA/gists{/gist_id}","starred_url":"https://api.github.com/users/MaccariTA/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MaccariTA/subscriptions","organizations_url":"https://api.github.com/users/MaccariTA/orgs","repos_url":"https://api.github.com/users/MaccariTA/repos","events_url":"https://api.github.com/users/MaccariTA/events{/privacy}","received_events_url":"https://api.github.com/users/MaccariTA/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter","state":"accepted"}],"collaborating_users":null,"collaborating_teams":null,"private_fork":null,"comments":1,"cvss":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1}},{"ghsa_id":"GHSA-5x8h-m52g-5v54","cve_id":"CVE-2025-53098","url":"https://api.github.com/repos/RooCodeInc/Roo-Code/security-advisories/GHSA-5x8h-m52g-5v54","html_url":"https://github.com/RooCodeInc/Roo-Code/security/advisories/GHSA-5x8h-m52g-5v54","summary":"Potential Remote Code Execution via Model Context Protocol in the Roo Code extension","description":"### Summary\r\n\r\nThe project-specific MCP configuration for the Roo Code agent is stored in the `.roo/mcp.json` file within the VS Code workspace. Because the MCP configuration format allows for execution of arbitrary commands, it would have been possible for an attacker with access to craft a prompt to ask the agent to write a malicious command to the MCP configuration file. If the user had opted-in to auto-approving file writes within the project, this would have led to arbitrary command execution.\r\n\r\n### Impact\r\n\r\nThis vulnerability is high complexity since it requires the attacker to already be able to submit prompts to the agent (for instance through a prompt injection attack), for the user to have MCP enabled (on by default), and for the user to have enabled auto-approved file writes (off by default), but also of high severity since it would give the attacker the ability to execute arbitrary code.\r\n\r\n### Remediation\r\n\r\nWe added an additional layer of opt-in configuration for auto-approving writing to Roo's configuration files, including all files within the `.roo/` folder.","severity":"high","author":null,"publisher":{"login":"mrubens","id":2600,"node_id":"MDQ6VXNlcjI2MDA=","avatar_url":"https://avatars.githubusercontent.com/u/2600?v=4","gravatar_id":"","url":"https://api.github.com/users/mrubens","html_url":"https://github.com/mrubens","followers_url":"https://api.github.com/users/mrubens/followers","following_url":"https://api.github.com/users/mrubens/following{/other_user}","gists_url":"https://api.github.com/users/mrubens/gists{/gist_id}","starred_url":"https://api.github.com/users/mrubens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrubens/subscriptions","organizations_url":"https://api.github.com/users/mrubens/orgs","repos_url":"https://api.github.com/users/mrubens/repos","events_url":"https://api.github.com/users/mrubens/events{/privacy}","received_events_url":"https://api.github.com/users/mrubens/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-5x8h-m52g-5v54","type":"GHSA"},{"value":"CVE-2025-53098","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2025-07-07T02:40:42Z","published_at":"2025-06-27T20:42:26Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"","name":""},"vulnerable_version_range":"< 3.20.3","patched_versions":"3.20.3","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[],"cwe_ids":[],"credits":[{"login":"MaccariTA","type":"reporter"}],"credits_detailed":[{"user":{"login":"MaccariTA","id":20310946,"node_id":"MDQ6VXNlcjIwMzEwOTQ2","avatar_url":"https://avatars.githubusercontent.com/u/20310946?v=4","gravatar_id":"","url":"https://api.github.com/users/MaccariTA","html_url":"https://github.com/MaccariTA","followers_url":"https://api.github.com/users/MaccariTA/followers","following_url":"https://api.github.com/users/MaccariTA/following{/other_user}","gists_url":"https://api.github.com/users/MaccariTA/gists{/gist_id}","starred_url":"https://api.github.com/users/MaccariTA/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MaccariTA/subscriptions","organizations_url":"https://api.github.com/users/MaccariTA/orgs","repos_url":"https://api.github.com/users/MaccariTA/repos","events_url":"https://api.github.com/users/MaccariTA/events{/privacy}","received_events_url":"https://api.github.com/users/MaccariTA/received_events","type":"User","user_view_type":"public","site_admin":false},"type":"reporter","state":"accepted"}],"collaborating_users":null,"collaborating_teams":null,"private_fork":null,"comments":1,"cvss":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","score":8.1}},{"ghsa_id":"GHSA-wr2q-46pg-f228","cve_id":"CVE-2025-53097","url":"https://api.github.com/repos/RooCodeInc/Roo-Code/security-advisories/GHSA-wr2q-46pg-f228","html_url":"https://github.com/RooCodeInc/Roo-Code/security/advisories/GHSA-wr2q-46pg-f228","summary":"Potential Information Leakage via JSON Schema in the Roo Code extension","description":"### Summary\r\n\r\nThere was an issue where the Roo Code agent's `search_files` tool did not respect the setting to disable reads outside of the VS Code workspace. This means that an attacker who was able to inject a prompt into the agent could potentially read a sensitive file and then write the information to a JSON schema.\r\n\r\nUsers have the option to disable schema fetching in VS Code, but the feature is enabled by default. For users with this feature enabled, writing to the schema would trigger a network request without the user having a chance to deny.\r\n\r\n### Impact\r\n\r\nThis issue is of moderate severity, since it requires the attacker to already be able to submit prompts to the agent.\r\n\r\n### Remediation\r\n\r\nWe fixed the issue where `search_files` did not respect the setting to limit it to the workspace. This reduces the scope of the damage if an attacker is able to take control of the agent through prompt injection or another vector.","severity":"medium","author":null,"publisher":{"login":"mrubens","id":2600,"node_id":"MDQ6VXNlcjI2MDA=","avatar_url":"https://avatars.githubusercontent.com/u/2600?v=4","gravatar_id":"","url":"https://api.github.com/users/mrubens","html_url":"https://github.com/mrubens","followers_url":"https://api.github.com/users/mrubens/followers","following_url":"https://api.github.com/users/mrubens/following{/other_user}","gists_url":"https://api.github.com/users/mrubens/gists{/gist_id}","starred_url":"https://api.github.com/users/mrubens/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrubens/subscriptions","organizations_url":"https://api.github.com/users/mrubens/orgs","repos_url":"https://api.github.com/users/mrubens/repos","events_url":"https://api.github.com/users/mrubens/events{/privacy}","received_events_url":"https://api.github.com/users/mrubens/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-wr2q-46pg-f228","type":"GHSA"},{"value":"CVE-2025-53097","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2025-06-27T21:36:00Z","published_at":"2025-06-27T20:42:22Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"","name":""},"vulnerable_version_range":"< 3.20.3","patched_versions":"3.20.3","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:N/A:N","score":5.9},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[],"cwe_ids":[],"credits":[