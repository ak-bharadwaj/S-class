[{"ghsa_id":"GHSA-gqw6-r8pm-9853","cve_id":null,"url":"https://api.github.com/repos/keptn/keptn/security-advisories/GHSA-gqw6-r8pm-9853","html_url":"https://github.com/keptn/keptn/security/advisories/GHSA-gqw6-r8pm-9853","summary":"Supply chain vulnerability in Keptn 0.1.0 to 0.8.2 due to deleted Google Storage bucket by Helm","description":"### TL;DR\r\nRemediation service container images between versions `0.7.3` to `0.8.2` are **not safe to use**.\r\nBuilding container images from Keptn's source code between versions `0.1.0` and `0.8.2` is **not safe**, although the released container images are **safe** (except listed above).\r\n\r\n### Summary\r\n\r\nThe vulnerability happened due to a deleted Google Storage bucket by the Helm project (kubernetes-helm bucket) that hosted the CLI binaries. The Helm project switched to GitHub releases for their CLI binaries and deleted the storage bucket which made the name (and therefore identical URL) available again for other users to take. This makes components that depend on the Helm CLI vulnerable to RCE **_at build time_** since the storage bucket can be taken by any user and during container image build time and the content of the bucket is downloaded into the container image without any integrity (or any other) checks.\r\n\r\n### Impact\r\n\r\nThis is a vulnerability that can only be exploited during build time of Dockerfiles from Keptn versions `0.1.0` to `0.8.2`.\r\n\r\n### Patches\r\n\r\nThe problem will not be patched since the affected versions are over 2 years old and are not built or maintained anymore by any automated system or otherwise.\r\n\r\nThe problem will be addressed by deleting the affected Docker images and deleting GitHub tags and release branches for the affected Keptn versions to avoid building the vulnerable code. Additionally, disclaimers will be added to the affected GitHub releases.\r\n\r\n### Workarounds/Mitigations\r\n\r\nThe vulnerability can be avoided by not building **any** of the aforementioned container images by oneself and using the released images instead.\r\n","severity":"medium","author":null,"publisher":{"login":"mowies","id":6901203,"node_id":"MDQ6VXNlcjY5MDEyMDM=","avatar_url":"https://avatars.githubusercontent.com/u/6901203?v=4","gravatar_id":"","url":"https://api.github.com/users/mowies","html_url":"https://github.com/mowies","followers_url":"https://api.github.com/users/mowies/followers","following_url":"https://api.github.com/users/mowies/following{/other_user}","gists_url":"https://api.github.com/users/mowies/gists{/gist_id}","starred_url":"https://api.github.com/users/mowies/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mowies/subscriptions","organizations_url":"https://api.github.com/users/mowies/orgs","repos_url":"https://api.github.com/users/mowies/repos","events_url":"https://api.github.com/users/mowies/events{/privacy}","received_events_url":"https://api.github.com/users/mowies/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-gqw6-r8pm-9853","type":"GHSA"}],"state":"published","created_at":null,"updated_at":"2023-04-25T06:03:49Z","published_at":"2023-04-25T06:03:49Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"docker","name":"keptn/helm-service"},"vulnerable_version_range":"> 0.1.0","patched_versions":"0.7.0","vulnerable_functions":[]},{"package":{"ecosystem":"docker","name":"keptn/installer"},"vulnerable_version_range":"> 0.2.2","patched_versions":"0.7.0","vulnerable_functions":[]},{"package":{"ecosystem":"docker","name":"keptn/remediation-service"},"vulnerable_version_range":"> 0.5.0.beta","patched_versions":"0.8.3","vulnerable_functions":[]},{"package":{"ecosystem":"docker","name":"keptn/upgrader"},"vulnerable_version_range":"0.7.0","patched_versions":"no newer versions available","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C: