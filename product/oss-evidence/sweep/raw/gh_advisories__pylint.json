[{"ghsa_id":"GHSA-22qq-2fwx-7p67","cve_id":"CVE-2026-114608","url":"https://api.github.com/repos/pylint-dev/pylint/security-advisories/GHSA-22qq-2fwx-7p67","html_url":"https://github.com/pylint-dev/pylint/security/advisories/GHSA-22qq-2fwx-7p67","summary":"Arbitrary code execution via pickle deserialization of the stats cache in PYLINT_HOME","description":"### Impact\r\n\r\nSince 2006 / pylint 0.15.2, pylint caches its stats as pickles in `PYLINT_HOME` and reload them on the next run with `pickle.load`. Someone without access to the configuration or linted code, but with access to the cache directory (predictable `PYLINT_HOME` on a multi-user host) can write a crafted pickle that will runs arbitrary code when pylint access its stat cache.\r\n\r\n### Patches\r\n\r\nFrom pylint 4.0.9, the result cache is now stored as JSON instead of pickle, preventing code-execution. \r\n\r\n### Workarounds\r\n\r\nUntil upgrading do not point `PYLINT_HOME` to an untrusted, shared, or group-writable directory. The default value, `~/.cache/pylint`, is writable only by the user running pylint.\r\n\r\n### References\r\n\r\n- Reported privately via Tidelift coordinated disclosure (Dan Lenz).\r\n","severity":"medium","author":null,"publisher":{"login":"Pierre-Sassoulas","id":5493666,"node_id":"MDQ6VXNlcjU0OTM2NjY=","avatar_url":"https://avatars.githubusercontent.com/u/5493666?v=4","gravatar_id":"","url":"https://api.github.com/users/Pierre-Sassoulas","html_url":"https://github.com/Pierre-Sassoulas","followers_url":"https://api.github.com/users/Pierre-Sassoulas/followers","following_url":"https://api.github.com/users/Pierre-Sassoulas/following{/other_user}","gists_url":"https://api.github.com/users/Pierre-Sassoulas/gists{/gist_id}","starred_url":"https://api.github.com/users/Pierre-Sassoulas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Pierre-Sassoulas/subscriptions","organizations_url":"https://api.github.com/users/Pierre-Sassoulas/orgs","repos_url":"https://api.github.com/users/Pierre-Sassoulas/repos","events_url":"https://api.github.com/users/Pierre-Sassoulas/events{/privacy}","received_events_url":"https://api.github.com/users/Pierre-Sassoulas/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-22qq-2fwx-7p67","type":"GHSA"},{"value":"CVE-2026-114608","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2026-10-22T16:49:32Z","published_at":"2026-09-23T05:17:04Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pylint"},"vulnerable_version_range":"< 4.0.9","patched_versions":"4.0.9","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":null},"cvss_v4":{"vector_string":"CVSS:4.0/AV:L/AC:H/AT:P/PR:L/UI:P/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","score":5.4}},"cwes":[],"cwe_ids":[],"credits":[],"credits_detailed":[],"collaborating_users":null,"collaborating_teams":null,"private_fork":null,"comments":4,"cvss":{"vector_string":null,"score":null}}]