[{"ghsa_id":"GHSA-x2pg-mjhr-2m5x","cve_id":"CVE-2022-31051","url":"https://api.github.com/repos/semantic-release/semantic-release/security-advisories/GHSA-x2pg-mjhr-2m5x","html_url":"https://github.com/semantic-release/semantic-release/security/advisories/GHSA-x2pg-mjhr-2m5x","summary":"Exposure of Sensitive Information to an Unauthorized Actor in semantic-release","description":"### Impact\r\n_What kind of vulnerability is it? Who is impacted?_\r\n\r\nSecrets that would normally be masked by semantic-release can be accidentally disclosed if they contain characters that are excluded from uri encoding by [encodeURI](https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/encodeURI). Occurrence is further limited to execution contexts where push access to the related repository is not available without modifying the repository url to inject credentials.\r\n\r\n### Patches\r\n_Has the problem been patched? What versions should users upgrade to?_\r\n\r\nFixed in 19.0.3\r\n\r\n### Workarounds\r\n_Is there a way for users to fix or remediate the vulnerability without upgrading?_\r\n\r\nSecrets that do not contain characters that are excluded from encoding with `encodeURI` when included in a URL are already masked properly.\r\n\r\n### References\r\n_Are there any links users can visit to find out more?_\r\n* https://github.com/semantic-release/semantic-release/releases/tag/v19.0.3\r\n* https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/encodeURI\r\n\r\n### For more information\r\nIf you have any questions or comments about this advisory:\r\n* Open a discussion in [semantic-release discussions](https://github.com/semantic-release/semantic-release/discussions)\r\n","severity":"medium","author":null,"publisher":{"login":"travi","id":126441,"node_id":"MDQ6VXNlcjEyNjQ0MQ==","avatar_url":"https://avatars.githubusercontent.com/u/126441?v=4","gravatar_id":"","url":"https://api.github.com/users/travi","html_url":"https://github.com/travi","followers_url":"https://api.github.com/users/travi/followers","following_url":"https://api.github.com/users/travi/following{/other_user}","gists_url":"https://api.github.com/users/travi/gists{/gist_id}","starred_url":"https://api.github.com/users/travi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/travi/subscriptions","organizations_url":"https://api.github.com/users/travi/orgs","repos_url":"https://api.github.com/users/travi/repos","events_url":"https://api.github.com/users/travi/events{/privacy}","received_events_url":"https://api.github.com/users/travi/received_events","type":"User","user_view_type":"public","site_admin":false},"identifiers":[{"value":"GHSA-x2pg-mjhr-2m5x","type":"GHSA"},{"value":"CVE-2022-31051","type":"CVE"}],"state":"published","created_at":null,"updated_at":"2022-06-09T18:29:05Z","published_at":"2022-06-09T16:19:03Z","closed_at":null,"withdrawn_at":null,"submission":null,"vulnerabilities":[{"package":{"ecosystem":"npm","name":"semantic-release"},"vulnerable_version_range":"17.0.4","patched_versions":"19.0.3","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":null},"cvss_v4":{"vector_string":null,"score":null}},"cwes":[{"cwe_id":"CWE-200","name":"Exposure of Sensitive Information to an Unauthorized Actor"}],"cwe_ids":["CWE-200"],"credits":[{"login":"dmosen","type":"analyst"}],"credits_detailed":[{"user":{"login":"dmosen","id":3847928,"node_id":"MDQ6VXNlcjM4NDc5Mjg=","avatar_url":"https://avatars.githubusercontent.com/u/3847928?v=4","gravatar_id":"","url":"https://api.github.com/users/dmosen","html_url":"https://github.com/dmosen","followers_url":"https://api.github.com/users/dmosen/followers","following_url":"https://api.github.com/users/dmosen/following{/other_user}","gists_url":"https://api.github.com/users/dmosen/gists{/gist_id}","starred_url":"https://api.github.com/users/dmosen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dmosen/subsc