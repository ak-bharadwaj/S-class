{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectCheckpoint",
  "schema_version": "1.0",
  "type": "object",
  "required": [
    "checkpoint_id",
    "repository_head",
    "working_tree_fingerprint",
    "verified_tasks",
    "rejected_claims",
    "blockers",
    "relevant_files",
    "constraints",
    "next_action",
    "timestamp",
    "checkpoint_hash"
  ],
  "properties": {
    "checkpoint_id": { "type": "string" },
    "repository_head": { "type": "string" },
    "working_tree_fingerprint": { "type": "string" },
    "active_task": { "type": ["string", "null"] },
    "verified_tasks": { "type": "array", "items": { "type": "string" } },
    "rejected_claims": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "relevant_files": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "checkpoint_hash": { "type": "string" }
  }
}
