+    out = evaluate_pd_f2_003_reference_evaluator_budget(valid_sat, authority=QUALIFIED_EVALUATOR_BOUNDARY)
+    assert out.state == GateState.SATISFIED
+    assert out.must_id == "PD-F2-003"
+
+
+def test_f2_003_valid_unsat_accepted():
