+        "must_id": "PD-F2-003",
+        "base_result": "UNSAT",
+        "budget_expired": True,
+    }
+    out = evaluate_pd_f2_003_reference_evaluator_budget(bad_unsat, authority=QUALIFIED_EVALUATOR_BOUNDARY)
