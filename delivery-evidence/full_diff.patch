+    if authority != QUALIFIED_EVALUATOR_BOUNDARY:
+        return GateOutput(GateState.MISSING, must_id="PD-F2-004", detail="Caller lacks qualified evaluator authority")
+
+    if not isinstance(evidence, Mapping):
