+    out = evaluate_pd_f2_003_reference_evaluator_budget(bad, authority=QUALIFIED_EVALUATOR_BOUNDARY)
+    assert out.state == GateState.MISSING
+
+
+def test_f2_003_missing_evidence_rejected():
