{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S-Class Orchestration Shared Execution State",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "currentPhase": {
      "type": "string",
      "enum": ["TRIAGE", "ANALYSIS", "CLARIFICATION", "DESIGN", "DEBATE", "TASK_COMPILATION", "CODING", "INTEGRATION", "QA", "RECOVERY", "RELEASE", "DONE"]
    },
    "activeEvent": {
      "type": ["string", "null"]
    },
    "workflowProfile": {
      "type": "string"
    },
    "planRationale": {
      "type": "string"
    },
    "currentSpecVersion": {
      "type": "integer",
      "minimum": 1
    },
    "currentDebateVersion": {
      "type": "integer",
      "minimum": 0
    },
    "currentTaskVersion": {
      "type": "integer",
      "minimum": 0
    },
    "retryCount": {
      "type": "integer",
      "minimum": 0
    },
    "confidenceMatrix": {
      "type": "object",
      "properties": {
        "weightedScore": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "votes": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      },
      "required": ["weightedScore", "votes"]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptanceCriteria": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"]
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "sandboxBranch": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "owner", "targets", "dependsOn", "acceptanceCriteria", "priority", "status"]
      }
    },
    "decisionLog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": { "type": "string" },
          "reason": { "type": "string" },
          "alternatives": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "timestamp": { "type": "string", "format": "date-time" },
          "agent": { "type": "string" }
        },
        "required": ["decision", "reason", "alternatives", "confidence", "timestamp", "agent"]
      }
    },
    "transitionHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stepIndex": { "type": "integer" },
          "fromState": { "type": "string" },
          "toState": { "type": "string" },
          "eventFired": { "type": "string" },
          "workflowProfile": { "type": "string" },
          "evidenceVerified": { "type": "array" },
          "decision": { "type": "object" },
          "timestamp": { "type": "string" },
          "agent": { "type": "string" }
        },
        "required": ["stepIndex", "fromState", "toState", "eventFired", "workflowProfile", "timestamp"]
      }
    }
  },
  "required": ["taskId", "currentPhase", "activeEvent", "currentSpecVersion", "currentDebateVersion", "currentTaskVersion", "retryCount", "confidenceMatrix", "tasks", "decisionLog"]
}
