{
  "version": 1,
  "hooks": {
    "beforeReadFile": [
      {
        "command": "python hook_runner.py --platform cursor --event-type beforeReadFile",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python hook_runner.py --platform cursor --event-type beforeShellExecution",
        "timeout": 15
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python hook_runner.py --platform cursor --event-type beforeMCPExecution",
        "timeout": 15
      }
    ],
    "preToolUse": [
      {
        "command": "python hook_runner.py --platform cursor --event-type preToolUse",
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": "python hook_runner.py --platform cursor --event-type afterFileEdit",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python hook_runner.py --platform cursor --event-type beforeSubmitPrompt",
        "timeout": 5
      }
    ]
  }
}