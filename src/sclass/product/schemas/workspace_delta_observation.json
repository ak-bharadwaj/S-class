{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sclass:v6.0.2:workspacedeltaobservation",
  "title": "WorkspaceDeltaObservation",
  "description": "Observation projection; HOST_NATIVE records detection/containment and never prevention.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "workspace_ref",
    "baseline_digest",
    "observed_delta_digest",
    "actor_classification",
    "scope_result",
    "enforcement_mode",
    "containment_result",
    "source_evidence_refs",
    "authority_class"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_ref": {
      "type": "string",
      "minLength": 1
    },
    "baseline_digest": {
      "type": "string",
      "minLength": 1
    },
    "observed_delta_digest": {
      "type": "string",
      "minLength": 1
    },
    "actor_classification": {
      "enum": [
        "WORKER_AUTHORIZED",
        "HOST_NATIVE_AGENT",
        "DEVELOPER",
        "GENERATED_TOOL",
        "CONCURRENT",
        "UNKNOWN"
      ]
    },
    "scope_result": {
      "enum": [
        "IN_SCOPE",
        "OUT_OF_SCOPE",
        "UNKNOWN"
      ]
    },
    "enforcement_mode": {
      "enum": [
        "PREVENTED",
        "DETECTED",
        "READ_ONLY"
      ]
    },
    "containment_result": {
      "enum": [
        "NONE",
        "REVERT_REQUESTED",
        "QUARANTINE_REQUESTED",
        "BLOCKED"
      ]
    },
    "source_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_class": {
      "enum": [
        "PROCESS_ARTIFACT",
        "DOCUMENTATION",
        "PROJECTION",
        "GUIDANCE",
        "IMPLEMENTATION_METADATA"
      ]
    }
  }
}