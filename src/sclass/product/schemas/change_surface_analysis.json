{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeSurfaceAnalysis",
  "description": "Product-layer artifact from section 2.9. P3 change surface analysis. This schema does not confer kernel authority.",
  "type": "object",
