      "type": "string",
      "minLength": 1
    },
    "target_snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_digest": {
      "type": "string",
      "minLength": 1
    },
    "content_digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "$id": "urn:sclass:v6.0.2:change-surface-analysis"
}