      }
    },
    "obligation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifier_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "freshness_policy_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "$id": "urn:sclass:v6.0.2:verification-plan-binding"
}