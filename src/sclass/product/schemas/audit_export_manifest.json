{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sclass:v6.0.2:auditexportmanifest",
  "title": "AuditExportManifest",
  "description": "Read-only export manifest with explicit completeness and truncation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "export_id",
    "source_binding_digest",
    "source_event_start",
    "source_event_end",
    "included_record_refs",
    "redacted_fields",
    "complete",
    "truncation_reason",
    "content_digest",
    "authority_class"
  ],
  "properties": {
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "source_binding_digest": {
      "type": "string",
      "minLength": 1
    },
    "source_event_start": {
      "type": "integer",
      "minimum": 0
    },
    "source_event_end": {
      "type": "integer",
      "minimum": 0
    },
    "included_record_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "redacted_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "complete": {
      "type": "boolean"
    },
    "truncation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_digest": {
      "type": "string",
      "minLength": 1
    },
    "authority_class": {
      "enum": [
        "PROCESS_ARTIFACT",
        "DOCUMENTATION",
        "PROJECTION",
        "GUIDANCE",
        "IMPLEMENTATION_METADATA"
      ]
    }
  }
}