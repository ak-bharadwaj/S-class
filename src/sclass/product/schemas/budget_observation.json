{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sclass:v6.0.2:budgetobservation",
  "title": "BudgetObservation",
  "description": "Operational telemetry with explicit units and source trust tier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "task_ref",
    "source_tier",
    "wall_clock_elapsed_seconds",
    "cpu_seconds",
    "memory_mb_seconds",
    "output_bytes",
    "context_utf8_bytes",
    "adapter_seconds",
    "retry_consumed",
    "source_digest",
    "authority_class"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_tier": {
      "enum": [
        "AUTHORITATIVE",
        "HOST_ATTESTED",
        "DEVELOPER_REPORTED",
        "MODEL_REPORTED"
      ]
    },
    "wall_clock_elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "cpu_seconds": {
      "type": "number",
      "minimum": 0
    },
    "memory_mb_seconds": {
      "type": "number",
      "minimum": 0
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "context_utf8_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "adapter_seconds": {
      "type": "number",
      "minimum": 0
    },
    "retry_consumed": {
      "type": "integer",
      "minimum": 0
    },
    "source_digest": {
      "type": "string",
      "minLength": 1
    },
    "authority_class": {
      "enum": [
        "PROCESS_ARTIFACT",
        "DOCUMENTATION",
        "PROJECTION",
        "GUIDANCE",
        "IMPLEMENTATION_METADATA"
      ]
    }
  }
}