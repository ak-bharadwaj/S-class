{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeSpec",
  "description": "Product-layer artifact from section 3.1. Spec-driven artifact. This schema does not confer kernel authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "objective_revision",
    "requirement_refs",
    "non_goals",
    "scope_digest",
    "spec_anchor_digest",
    "content_digest"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "objective_revision": {
      "type": "integer",
      "minimum": 0
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_digest": {
      "type": "string",
      "minLength": 1
    },
    "spec_anchor_digest": {
      "type": "string",
      "minLength": 1
    },
    "content_digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "$id": "urn:sclass:v6.0.2:change-spec"
}