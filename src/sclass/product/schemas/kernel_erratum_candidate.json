{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sclass:v6.0.2:kernelerratumcandidate",
  "title": "KernelErratumCandidate",
  "description": "Erratum candidate must prove frozen representation insufficiency and replay/migration impact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "frozen_objects_considered",
    "invariant_statement",
    "exact_insufficiency",
    "adversarial_test_ref",
    "replay_impact",
    "migration_impact",
    "compatibility_break",
    "decision_status",
    "authority_class"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "frozen_objects_considered": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariant_statement": {
      "type": "string",
      "minLength": 1
    },
    "exact_insufficiency": {
      "type": "string",
      "minLength": 1
    },
    "adversarial_test_ref": {
      "type": "string",
      "minLength": 1
    },
    "replay_impact": {
      "type": "string",
      "minLength": 1
    },
    "migration_impact": {
      "type": "string",
      "minLength": 1
    },
    "compatibility_break": {
      "type": "boolean"
    },
    "decision_status": {
      "enum": [
        "PROPOSED",
        "ACCEPTED",
        "REJECTED",
        "DEFERRED"
      ]
    },
    "authority_class": {
      "enum": [
        "PROCESS_ARTIFACT",
        "DOCUMENTATION",
        "PROJECTION",
        "GUIDANCE",
        "IMPLEMENTATION_METADATA"
      ]
    }
  }
}