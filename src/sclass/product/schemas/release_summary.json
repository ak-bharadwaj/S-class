{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReleaseSummary",
  "description": "Product-layer artifact from section 2.16. deterministic rendering of kernel result. This schema does not confer kernel authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_evaluation_digest",
    "policy_version",
    "evaluation_instant",
    "required_obligation_refs",
    "blocker_refs",
    "content_digest"
  ],
  "properties": {
    "release_evaluation_digest": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_instant": {
      "type": "string",
      "format": "date-time"
    },
    "required_obligation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocker_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "$id": "urn:sclass:v6.0.2:release-summary"
}