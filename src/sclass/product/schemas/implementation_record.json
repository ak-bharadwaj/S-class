{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplementationRecord",
  "description": "Product-layer artifact from section 2.12. product projection; delta needs kernel receipt. This schema does not confer kernel authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "implementation_id",
    "task_ref",
    "target_snapshot_ref",
    "authorized_scope_digest",
    "delta_ref",
    "changed_paths",
    "claim_refs",
    "test_input_set_ref",
    "content_digest"
  ],
  "properties": {
    "implementation_id": {
      "type": "string",
      "minLength": 1
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "authorized_scope_digest": {
      "type": "string",
      "minLength": 1
    },
    "delta_ref": {
      "type": "string",
      "minLength": 1
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_input_set_ref": {
      "type": "string",
      "minLength": 1
    },
    "content_digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "$id": "urn:sclass:v6.0.2:implementation-record"
}